{
  "name": "declarative-forms",
  "version": "2.0.1",
  "description": "Declarative, data-driven form dialogs for the web. Zero dependencies, framework agnostic, with async options, cross-field reactivity, tabs and modal stacking.",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/components/*"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./styles/declarative-forms.css",
    "./theme.css": "./styles/declarative-forms.css",
    "./classic.css": "./styles/classic.css",
    "./assets/default.css": "./styles/classic.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "example": "vite --config examples/vite.config.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wolfoo2931/declarative-forms.git"
  },
  "keywords": [
    "forms",
    "form-builder",
    "declarative",
    "modal",
    "dialog",
    "web-components",
    "combobox",
    "typescript",
    "zero-dependencies",
    "framework-agnostic"
  ],
  "author": "Oliver Wolf",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wolfoo2931/declarative-forms/issues"
  },
  "homepage": "https://github.com/wolfoo2931/declarative-forms#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "happy-dom": "^20.11.2",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10"
  }
}
