{
  "name": "declarativ_forms",
  "version": "0.1.0",
  "description": "",
  "main": "src/declarativ_forms.js",
  "types": "./types/main.d.ts",
  "scripts": {
    "package": "./node_modules/browserify/bin/cmd.js -r ./src/declarativ_forms.js src/declarativ_forms.js -o assets/declarativ_forms.js.packaged.js",
    "package:min": "./node_modules/browserify/bin/cmd.js -r ./src/declarativ_forms.js src/declarativ_forms.js -o assets/declarativ_forms.js.packaged.js | sed '1s/^/var /' | node_modules/google-closure-compiler/cli.js  > assets/declarativ_form.packaged.min.js",
    "package:watch": "./node_modules/watchify/bin/cmd.js -r ./src/declarativ_forms.js src/declarativ_forms.js -o assets/declarativ_form.packaged.js -v",
    "test:browser": "./node_modules/.bin/wdio wdio.conf.js",
    "test": "./node_modules/karma/bin/karma start",
    "build:types": "tsc",
    "webdriver:start": "webdriver-manager update && webdriver-manager start"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:wolfoo2931/declarativ-forms.git"
  },
  "keywords": [
    "modal",
    "forms"
  ],
  "author": "Oliver Wolf",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wolfoo2931/declarativ-forms/issues"
  },
  "homepage": "https://github.com/wolfoo2931/declarativ-forms#readme",
  "dependencies": {
    "@react-hookz/deep-equal": "^1.0.4",
    "tippy.js": "^6.3.7",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "typescript": "^5.2.2"
  }
}
